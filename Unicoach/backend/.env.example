# ══════════════════════════════════════════════════════════════════════════════
# UniCoach Backend — environment variables (template, NO real values here)
#
# Local dev : copy this file to backend/.env and fill in development values.
# Production: add every variable in Coolify → backend app → Environment Variables,
#             and UNTICK "Build Variable" for all of them (the backend reads them only at runtime).
#
# [REQUIRED]          the live site breaks or is insecure without it
# [REQUIRED for X]    only feature X breaks without it
# (optional)          safe to leave empty
#
# Some settings can ALSO be saved in Admin → Settings (stored in MongoDB). For Razorpay, Cloudinary,
# Twilio and SMTP the database value WINS over the value here — keep those admin fields empty
# unless you really want to override the environment.
#
# Not read by the code (do not bother setting): EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASS
# (old names, use SMTP_* below), GOOGLE_CLIENT_SECRET, SERPAPI_API_KEY.
# ══════════════════════════════════════════════════════════════════════════════


# ── 1. Server ─────────────────────────────────────────────────────────────────
# [REQUIRED] "production" on the live server: secure cookies, strict CORS, hidden error details,
# no payment simulator, no OTP codes in logs. Use "development" locally.
NODE_ENV=production
# Port the API listens on inside the container (Coolify "Ports Exposes" must be the same). Default 5000.
PORT=5000


# ── 2. Database (MongoDB Atlas) ───────────────────────────────────────────────
# [REQUIRED] The server exits at startup if this is missing.
# Use a least-privilege user (readWrite on the "unicoach" database only). Use a password with
# only letters and digits, otherwise special characters must be URL-encoded.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/unicoach?retryWrites=true&w=majority&appName=unicoach
# (optional) Separate database just for the mentorship/booking module (unicoach_* collections).
# Leave empty to keep everything in MONGO_URI (normal setup).
UNICOACH_MONGO_URI=


# ── 3. Redis (response cache, booking slot locks, idempotency keys) ───────────
# [REQUIRED in production] Without it the app falls back to in-memory locks/cache, which is only
# safe while exactly ONE backend container runs (during a zero-downtime deploy two run at once).
# Coolify: paste the Redis "internal URL", e.g. redis://default:<password>@<redis-container-name>:6379/0
# Local dev: leave empty (or redis://127.0.0.1:6379 if you run Redis).
REDIS_URL=


# ── 4. Security ───────────────────────────────────────────────────────────────
# [REQUIRED] Signs login tokens. The server REFUSES TO START if it is missing or shorter than
# 16 characters. Use a long random value:   openssl rand -hex 48
# Changing it logs every user and admin out (they just log in again).
JWT_SECRET=
# (optional) With this set, https://api.unicoach.com/api/health?key=<HEALTH_SECRET> also shows
# database state, uptime and memory in production. Without it only status + timestamp are shown.
HEALTH_SECRET=


# ── 5. Public URLs & CORS ─────────────────────────────────────────────────────
# [REQUIRED] Public website (no trailing slash). Used for CORS, email links and password-reset links.
# Local dev: http://localhost:5173
FRONTEND_URL=https://www.unicoach.com
# [REQUIRED] Admin panel (no trailing slash). Used for CORS. Local dev: http://localhost:5174
ADMIN_URL=https://admin.unicoach.com
# (optional) Extra exact origins allowed to call the API with cookies, comma separated.
# https://*.unicoach.com and https://*.unicoach.in (and the bare domains) are already allowed by the code.
# Example: CORS_ORIGINS=https://staging.example.com,https://preview.example.com
CORS_ORIGINS=


# ── 6. Google Sign-In ─────────────────────────────────────────────────────────
# [REQUIRED] OAuth 2.0 Web Client ID from Google Cloud Console (…apps.googleusercontent.com).
# Must be the SAME value as the frontend build variable VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=


# ── 7. Payments: Razorpay (only payment gateway) ──────────────────────────────
# Full setup: RAZORPAY_PAYMENT_SETUP_GUIDE.md
# [REQUIRED for payments] Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# [REQUIRED for payments] Same secret as the Razorpay webhook (Test and Live webhooks are separate).
# Webhook URL: https://api.unicoach.com/api/unicoach/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Automatic mentor payouts (Razorpay Route). Set "true" only after Razorpay activates Route.
RAZORPAY_ROUTE_ENABLED=false
# (optional) Business category used when opening a mentor's Route linked account
RAZORPAY_ROUTE_CATEGORY=education
RAZORPAY_ROUTE_SUBCATEGORY=coaching
# (optional, legacy) PayPal is still read by the code but is not used. Leave empty.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox


# ── 8. Email — primary: Resend (HTTPS API) ────────────────────────────────────
# [REQUIRED] API key from https://resend.com (the booking.unicoach.com domain is verified in Resend).
RESEND_API_KEY=
# [REQUIRED] Sender address on the VERIFIED Resend domain (booking.unicoach.com). Resend rejects any
# other domain, so keep the @booking.unicoach.com part. In Coolify type it without quotes.
RESEND_FROM="UniCoach <bookings@booking.unicoach.com>"
# [REQUIRED] true once the domain shows "Verified" in Resend (it does). Without it no email is sent.
RESEND_DOMAIN_VERIFIED=true
# Replies to Resend emails go here (the sending domain has no inbox). Defaults to SMTP_USER.
EMAIL_REPLY_TO=unicoachedu@gmail.com


# ── 9. Email — optional SMTP fallback (OFF by default) ───────────────────────
# All email goes through Resend (section above). SMTP is only used if you set EMAIL_SMTP_FALLBACK=true;
# otherwise a Resend failure is logged as an error instead of switching to Gmail.
EMAIL_SMTP_FALLBACK=false
# SMTP_USER is also the default reply-to inbox when EMAIL_REPLY_TO is empty.
# Gmail (only if you enable the fallback): turn on 2-Step Verification, create an App Password for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
# 465 (SSL) or 587 (STARTTLS). If empty, Gmail defaults to 465.
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Display name + address used as "From" for SMTP mail. In Coolify type it without quotes.
SMTP_FROM="UniCoach <your-account@gmail.com>"


# ── 10. File uploads: Cloudinary ──────────────────────────────────────────────
# [REQUIRED in production] Without it uploaded images/documents stay on the server disk
# (/app/uploads). Mentor resources are ALWAYS stored in /app/uploads, so the Coolify persistent
# volume on /app/uploads is needed in any case.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ── 11. SMS OTP: Twilio ───────────────────────────────────────────────────────
# [REQUIRED for SMS OTP] Without it SMS is not sent (in development the OTP is printed to the console).
# The Account SID starts with "AC". Phone number in E.164 format, e.g. +1XXXXXXXXXX.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# ── 12. AI features ───────────────────────────────────────────────────────────
# [REQUIRED for AI tools] SOP generator, IELTS evaluator, UniBot, roadmap, course crawler.
# Key from https://console.groq.com
GROQ_API_KEY=
# (optional) OpenAI key used as a fallback when Groq fails.
OPENAI_API_KEY=


# ── 13. Error tracking ────────────────────────────────────────────────────────
# (optional) Sentry DSN for backend errors (https://sentry.io → Project → Client Keys).
SENTRY_DSN=


# ── Scripts only (NOT read by the running server) ─────────────────────────────
# scripts/test-all-apis.mjs: API base URL to benchmark
# BACKEND_URL=http://localhost:5000

# ── US university data: College Scorecard (free key from https://api.data.gov/signup) ──
COLLEGE_SCORECARD_API_KEY=

# ── Web page fetching for data sync: scrape.do (https://scrape.do) ──
SCRAPE_DO_TOKEN=

# ── Meta (Facebook/Instagram) Conversions API (services/metaConversions.js) ──
# (optional) Sends Lead / CompleteRegistration / Purchase from the server too, so Meta Ads still sees
# conversions when the browser pixel is blocked. Same Pixel ID as the frontend VITE_META_PIXEL_ID.
# Token: Events Manager → your dataset → Settings → Conversions API → Generate access token.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# (optional) Test code from Events Manager → Test events; remove it once events show up correctly.
META_TEST_EVENT_CODE=
