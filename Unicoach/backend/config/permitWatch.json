{
  "_readme": [
    "Irish employment-permit pages to watch for changes.",
    "To add a link: copy one block in 'pages', change url + label, save. Nothing else to do.",
    "To stop watching a page without deleting it: set \"enabled\": false.",
    "intervalMinutes: default gap between checks of one page. newsIntervalMinutes is the faster gap",
    "used by the news pages (marked everyMinutes: 5). Add everyMinutes to any page to give it its own gap.",
    "employmentpermits.enterprise.gov.ie is the online application portal. It is currently down and",
    "answers 403 with a holding page, so it is watched with acceptStatus so the day it returns shows",
    "up as a change. The permit CONTENT lives on enterprise.gov.ie under",
    "/what-we-do/workplace-and-skills/employment-permits/."
  ],

  "intervalMinutes": 30,
  "newsIntervalMinutes": 5,
  "tickMinutes": 5,
  "requestTimeoutMs": 30000,
  "delayBetweenPagesMs": 3000,
  "retriesPerPage": 3,
  "failAlertAfterHours": 4,
  "failAlertRepeatHours": 24,
  "userAgent": "Mozilla/5.0 (compatible; UniCoach-PermitWatch/1.0; +https://www.unicoach.com) change-monitor, contact via website",

  "stripSelectors": [
    "script", "style", "noscript", "iframe", "svg",
    "nav", "header", "footer",
    "input", "select", "textarea", "button",
    "[class*='cookie']", "[id*='cookie']", "[class*='Cookie']", "[id*='Cookie']",
    "[class*='breadcrumb']", "[class*='carousel']", "[class*='slider']",
    "[class*='social']", "[class*='share']", "[class*='search']",
    "[class*='skip-link']", "[class*='back-to-top']",
    "[class*='site-header']", "[class*='sub-header']", "[class*='utility-section']",
    "[class*='language-switcher']", "[class*='logo-and-tagline']", "[class*='burger']",
    "[class*='site-footer']", "[class*='aspNetHidden']",
    "[role='navigation']", "[role='banner']", "[role='contentinfo']", "[role='search']"
  ],

  "contentSelectors": ["main", "#main", "[role='main']", ".mainArea", "#main-content", ".main-content", "article", "#content", "body"],

  "ignoreLinePatterns": [
    "^last updated",
    "^page last reviewed",
    "^published:?\\s",
    "^\\d+\\s+views?$",
    "^©",
    "^copyright",
    "^cookies?\\b",
    "^accept all",
    "^share this page"
  ],

  "discovery": {
    "_note": "Pulls the whole employment-permits section out of the site's sitemap, so a brand-new page the Department publishes is watched automatically (and that new page itself is an alert).",
    "enabled": true,
    "sitemapUrl": "https://enterprise.gov.ie/sitemap.xml",
    "refreshHours": 12,
    "maxPages": 40,
    "includePrefixes": [
      "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/employment-permits/",
      "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/economic-migration-policy/"
    ],
    "excludePatterns": ["\\.pdf$", "\\.docx?$", "\\.xlsx?$", "/ga/"]
  },

  "pages": [
    {
      "label": "Employment Permits Online portal (employmentpermits.enterprise.gov.ie)",
      "_note": "The portal itself. It answers 403 with a 'service unavailable' holding page, so 403 is accepted as content: the day the portal comes back, that is the change.",
      "url": "https://employmentpermits.enterprise.gov.ie/",
      "enabled": true,
      "everyMinutes": 5,
      "acceptStatus": [403, 503, 404]
    },
    {
      "label": "Employment Permits - home",
      "url": "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/employment-permits/",
      "enabled": true,
      "everyMinutes": 5
    },
    {
      "label": "Employment Permits - latest updates",
      "url": "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/employment-permits/latest-updates/",
      "enabled": true,
      "everyMinutes": 5
    },
    {
      "label": "Critical Skills Occupations List (CSOL)",
      "url": "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/economic-migration-policy/occupations-lists-and-reviews/csol.html",
      "enabled": true
    },
    {
      "label": "Ineligible Occupations List (IOL)",
      "url": "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/economic-migration-policy/occupations-lists-and-reviews/iol.html",
      "enabled": true
    },
    {
      "label": "Employment permit fees",
      "url": "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/employment-permits/fees/",
      "enabled": true
    },
    {
      "label": "Current application processing dates",
      "url": "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/employment-permits/current-application-processing-dates/",
      "enabled": true
    },
    {
      "label": "Permit types",
      "url": "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/employment-permits/permit-types/",
      "enabled": true
    },
    {
      "label": "Employment permit eligibility",
      "url": "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/employment-permits/employment-permit-eligibility/",
      "enabled": true
    },
    {
      "label": "Trusted Partner Initiative",
      "url": "https://enterprise.gov.ie/en/what-we-do/workplace-and-skills/employment-permits/trusted-partner-initiative/",
      "enabled": true
    },
    {
      "label": "Department news (announcements)",
      "url": "https://enterprise.gov.ie/en/news-and-events/department-news/",
      "enabled": true,
      "everyMinutes": 5
    }
  ]
}
