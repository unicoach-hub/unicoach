# Files Docker must NOT copy into the admin build (build context = admin/).

# Dependencies are installed inside the image with `npm ci`; dist is rebuilt there too
node_modules
dist
dist-ssr
npm-debug.log*
*.log

# Local env files: VITE_* values come from Coolify build variables only
.env
.env.*
*.local

# Tests and reports
playwright-report
test-results
coverage

# Editor / OS / VCS
.vscode
.idea
.DS_Store
.git
.gitignore

# Build files themselves (nginx.conf IS needed, keep it)
Dockerfile
.dockerignore
