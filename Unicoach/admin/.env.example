# ══════════════════════════════════════════════════════════════════════════════
# UniCoach Admin Panel — build-time variables (template, NO real values here)
#
# Vite bakes these into the JavaScript bundle when the app is BUILT.
# Local dev : copy to admin/.env and use the local values shown in the comments.
# Production: Coolify → admin app → Environment Variables, with "Build Variable" ticked,
#             then Redeploy (a Restart does not rebuild, so it would keep the old values).
# These values are public (anyone can read them in the browser). Never put secrets here.
# ══════════════════════════════════════════════════════════════════════════════

# [REQUIRED] Backend API base URL, including /api, no trailing slash.
# Local dev: http://localhost:5000/api
# (Old setups used VITE_BACKEND_URL; it still works and wins if both are set — use only VITE_API_URL.)
VITE_API_URL=https://unicoach-1.onrender.com/api

# Public website URL, used to build shareable form / booking links.
# Local dev: http://localhost:5173
VITE_FRONTEND_URL=https://www.unicoach.com

# (optional) Sentry DSN for admin panel crash reports. Leave empty to disable.
VITE_SENTRY_DSN=
