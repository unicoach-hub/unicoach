# Frontend Web App Environment Variables Template
# Vite bakes these into the bundle at BUILD time — they are public, never put secrets here.

# Backend API base URL (read by src/config.js; trailing slash is stripped and '/api' is appended if missing).
# Production: https://api.unicoach.in/api   Local dev: http://localhost:5000/api
# If unset, the app picks automatically: unicoach.in -> https://api.unicoach.in/api,
# localhost -> http://localhost:5000/api, anything else -> https://unicoach-1.onrender.com/api.
# A localhost value is ignored when the site is served from a real domain.
# (Legacy aliases VITE_BACKEND_URL / VITE_API_BASE_URL are still read, but prefer VITE_API_URL.)
VITE_API_URL=https://unicoach-1.onrender.com/api

# Google OAuth web client ID (Google Sign-In button; empty = built-in production client ID)
VITE_GOOGLE_CLIENT_ID=

# Optional: Sentry DSN for error monitoring
VITE_SENTRY_DSN=

# Optional: ad tracking (src/utils/adTracking.js). Empty = that tag is not loaded.
# Meta Pixel ID (Events Manager → Data sources). Must equal the backend's META_PIXEL_ID.
VITE_META_PIXEL_ID=
# Google Ads tag ID (Google Ads → Goals → Conversions → Tag setup), e.g. AW-123456789
VITE_GOOGLE_ADS_ID=
# Conversion labels: the part after the slash in send_to "AW-123456789/AbCdEf..."
VITE_GOOGLE_ADS_LEAD_LABEL=
VITE_GOOGLE_ADS_SIGNUP_LABEL=
VITE_GOOGLE_ADS_PURCHASE_LABEL=
